<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cài đặt"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Kết nối và cấu hình"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <include
                layout="@layout/view_online_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Thẻ kết nối -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trạng thái kết nối"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Firebase"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvConnFirebase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Thiết bị ESP32"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvConnDevice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sóng Wi-Fi của thiết bị"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvConnWifi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tài khoản"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvConnAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickCheck"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Kiểm tra mực nước &amp; tình trạng tức thì"
                android:textColor="@color/primary"
                android:textSize="13sp"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_drop"
                app:iconGravity="textStart"
                app:iconTint="@color/primary"
                app:strokeColor="@color/primary" />
        </LinearLayout>

        <!-- Thẻ cấu hình bể -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cấu hình đo và ngưỡng cảnh báo"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilHeight"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="Chiều cao cảm biến so với đáy bể"
                app:helperText="Dùng để đổi khoảng cách ESP đo được thành mực nước hiện tại."
                app:suffixText="cm">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSensorHeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilOn"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="Ngưỡng cảnh báo"
                app:helperText="Mực nước đạt hoặc vượt giá trị này thì cảnh báo."
                app:suffixText="cm">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etThresholdOn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilOff"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Ngưỡng nguy hiểm"
                app:helperText="Mực nước đạt hoặc vượt giá trị này thì nguy hiểm."
                app:suffixText="cm">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etThresholdOff"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Mực nước = chiều cao cảm biến − khoảng cách ESP32 đo được. Mực nước càng cao càng nguy hiểm."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveConfig"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Lưu cấu hình"
                app:backgroundTint="@color/primary"
                app:cornerRadius="14dp" />
        </LinearLayout>

        <!-- Lưu trữ dữ liệu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lưu trữ dữ liệu" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="ESP32 lưu lịch sử lên Firebase mỗi phút; điện thoại cũng lưu một bản sao CSV mỗi phút để có thể xuất khi cần." android:textColor="@color/text_secondary" android:textSize="13sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Tệp CSV được tự động xuất mỗi ngày vào Downloads/MucNuoc (gần 00:05)." android:textColor="@color/text_secondary" android:textSize="12sp" />
            <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/toggleChartInterval" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="10dp" app:singleSelection="true" app:selectionRequired="true">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnInterval3" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="3 giây" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnInterval5" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="5 giây" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnInterval10" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="10 giây" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnExportCsv" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginEnd="5dp" android:layout_weight="1" android:text="Xuất Excel (.csv)" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnClearHistory" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="5dp" android:layout_weight="1" android:text="Xóa lịch sử" android:textColor="@color/red" app:strokeColor="@color/red" />
            </LinearLayout>
        </LinearLayout>

        <!-- Giao diện và ngôn ngữ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Giao diện" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchDarkMode" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Chế độ tối" android:textColor="@color/text_primary" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Đơn vị khoảng cách" android:textColor="@color/text_secondary" android:textSize="13sp" />
            <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/toggleDistanceUnit" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" app:singleSelection="true" app:selectionRequired="true"><com.google.android.material.button.MaterialButton android:id="@+id/btnUnitCm" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="cm"/><com.google.android.material.button.MaterialButton android:id="@+id/btnUnitM" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="m"/></com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <!-- Thẻ hướng dẫn kiểm tra kết nối -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hướng dẫn kiểm tra kết nối"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="4dp"
                android:text="1. Điện thoại có Internet và mục Firebase ở trên báo Đã kết nối.\n2. ESP32 đã cấp nguồn và vào được Wi-Fi.\n3. Thiết bị phải ở trạng thái Online. Nếu Offline, kiểm tra nguồn và Wi-Fi của ESP32.\n4. Báo Lỗi cảm biến: kiểm tra dây HC-SR04 (Trig, Echo, 5V, GND và cầu phân áp cho chân Echo).\n5. Báo không có quyền đọc dữ liệu: đăng nhập đúng tài khoản và kiểm tra Rules của Firebase."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Đăng xuất"
            android:textColor="@color/red"
            app:cornerRadius="14dp"
            app:strokeColor="@color/red" />
    </LinearLayout>
</ScrollView>
