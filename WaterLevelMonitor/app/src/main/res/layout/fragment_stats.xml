<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thống kê" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />
  <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/statsTabs" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="16dp" app:selectionRequired="true" app:singleSelection="true">
   <com.google.android.material.button.MaterialButton android:id="@+id/tabWater" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:text="Khoảng cách" />
   <com.google.android.material.button.MaterialButton android:id="@+id/tabMotor" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:text="Lịch sử thiết bị" />
  </com.google.android.material.button.MaterialButtonToggleGroup>
  <LinearLayout android:id="@+id/waterStatsPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:orientation="vertical">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thống kê khoảng cách" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />
   <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/statsRanges" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="12dp" app:selectionRequired="true" app:singleSelection="true"><com.google.android.material.button.MaterialButton android:id="@+id/rangeHour" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:text="Theo giờ" android:textSize="12sp"/><com.google.android.material.button.MaterialButton android:id="@+id/rangeWeek" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:text="Theo tuần" android:textSize="12sp"/><com.google.android.material.button.MaterialButton android:id="@+id/rangeMonth" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:text="Theo tháng" android:textSize="12sp"/></com.google.android.material.button.MaterialButtonToggleGroup>
   <include layout="@layout/view_stats_cards" />
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Biểu đồ cột mực nước" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Trung bình theo từng khoảng thời gian" android:textColor="@color/text_secondary" android:textSize="12sp"/><com.nhom6.waterlevelmonitor.ui.BarChartView android:id="@+id/barChart" android:layout_width="match_parent" android:layout_height="230dp" android:layout_marginTop="8dp"/></LinearLayout>
  </LinearLayout>
  <LinearLayout android:id="@+id/motorStatsPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:orientation="vertical" android:visibility="gone"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lịch sử thiết bị" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal"><include layout="@layout/view_motor_stat_total"/><include layout="@layout/view_motor_stat_open"/><include layout="@layout/view_motor_stat_close"/></LinearLayout><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Các thao tác gần đây" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold"/><LinearLayout android:id="@+id/motorHistory" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical"/></LinearLayout>
 </LinearLayout>
</ScrollView>
